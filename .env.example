# Deepseek Anthropic web search API 配置
DEEPSEEK_API_KEY=your-api-key-here

# Tavily 网页搜索 API 配置
# 获取：https://tavily.com 后台申请，免费档每月 1000 次搜索
TAVILY_API_KEY=tvly-your-api-key-here

# LLM endpoint 配置（OpenAI 兼容格式）
OPENAI_API_KEY=your-api-key-here

# 自定义 base URL（可选）
# 不设置则用 OpenAI SDK 默认地址
# 示例：DeepSeek 官方 https://api.deepseek.com/v1
# 示例：本地代理 http://localhost:8080/v1
# OPENAI_API_BASE=https://api.deepseek.com/v1

